rules_version = '2';
// 플래시카드: 로그인한 본인 데이터(users/{내 uid}/...)만 읽고 쓸 수 있음
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{kind}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && kind in ['decks', 'notes', 'cards', 'revlog', 'media', 'meta'];
    }
  }
}
